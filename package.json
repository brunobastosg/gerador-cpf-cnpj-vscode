{
    "name": "gerador-cpf-cnpj",
    "displayName": "Gerador de CPF/CNPJ",
    "description": "Gera CPFs e CNPJs válidos e insere diretamente no código",
    "version": "1.4.0",
    "publisher": "brunobastosg",
    "repository": {
        "type": "git",
        "url": "https://github.com/brunobastosg/gerador-cpf-cnpj-vscode"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.101.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "images/icon.png",
    "main": "./dist/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "geradorCpfCnpj.mcp",
                "label": "Gerador de CPF/CNPJ"
            }
        ],
        "commands": [
            {
                "command": "extension.gerarCPF",
                "title": "Gerar CPF",
                "category": "Gerador de CPF/CNPJ"
            },
            {
                "command": "extension.gerarCNPJ",
                "title": "Gerar CNPJ",
                "category": "Gerador de CPF/CNPJ"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "extension.gerarCPF",
                    "group": "1_modification",
                    "when": "config.geradorCpfCnpj.habilitarMenuDeContexto"
                },
                {
                    "command": "extension.gerarCNPJ",
                    "group": "1_modification",
                    "when": "config.geradorCpfCnpj.habilitarMenuDeContexto"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Gerador de CPF/CNPJ",
            "properties": {
                "geradorCpfCnpj.somenteNumeros": {
                    "type": "boolean",
                    "default": false,
                    "description": "Gera CPF/CNPJ sem a máscara. Em CNPJ alfanumérico, preserva as letras. Pode ser sobrescrita por chamada no MCP."
                },
                "geradorCpfCnpj.habilitarMenuDeContexto": {
                    "type": "boolean",
                    "default": true,
                    "description": "Habilita a opção de gerar CPF/CNPJ através do menu de contexto."
                },
                "geradorCpfCnpj.habilitarCnpjAlfanumerico": {
                    "type": "boolean",
                    "default": true,
                    "description": "Habilita a geração de CNPJ alfanumérico. Pode ser sobrescrita por chamada no MCP."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test",
        "deploy": "vsce publish --yarn"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.8",
        "@types/node": "20.x",
        "@types/vscode": "1.101.0",
        "@typescript-eslint/eslint-plugin": "^8.7.0",
        "@typescript-eslint/parser": "^8.7.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^2.4.1",
        "@vscode/vsce": "^3.1.1",
        "esbuild": "^0.28.1",
        "eslint": "^9.11.1",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3"
    }
}
